# Copy to .env (gitignored). Auth: az login locally, managed identity on Azure Container Apps.
LLM_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini
LLM_TIMEOUT_S=20
LLM_RETRIES=1
LLM_MAX_COMPLETION_TOKENS=400
LLM_REASONING_EFFORT=minimal
LLM_PERSONA_REWRITE=0
ECHO_FAULT_AGENTS=
