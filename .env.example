# Copy to .env only for a local Foundry run. .env is gitignored. Offline needs no file:
#   $env:LLM_MODE="offline"
# Do not put keys, tokens or a real endpoint in this file. Auth is `az login` locally
# and a managed identity on Azure Container Apps.
# The placeholder endpoint below is not a real project. Replace <account> and <project>
# before you rely on LLM_MODE=foundry.

LLM_MODE=foundry
# Alias accepted by the app: AZURE_AI_PROJECT_ENDPOINT
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Alias accepted by the app: AZURE_AI_MODEL_DEPLOYMENT_NAME
FOUNDRY_MODEL=gpt-5-mini
# auto | cli | managed | default.
# auto: Azure CLI when `az` is on PATH and CONTAINER_APP_NAME is unset;
# managed identity (AZURE_CLIENT_ID) when CONTAINER_APP_NAME is set;
# otherwise DefaultAzureCredential. Any value other than auto, cli or managed
# also uses DefaultAzureCredential.
FOUNDRY_CREDENTIAL=auto
LLM_TIMEOUT_S=20
LLM_RETRIES=1
LLM_MAX_COMPLETION_TOKENS=400
LLM_REASONING_EFFORT=minimal
LLM_PERSONA_REWRITE=0
# Empty, or a comma list. "narrator" fails that agent's first call (amber recovered).
# "narrator!" fails every narrator call (red fallback, source safe_template).
# Restart the server after changing this.
ECHO_FAULT_AGENTS=

# Optional. Leave these commented so a copied file keeps the code defaults
# (6 per IP per hour, 150 per UTC day, 4 concurrent, 200 replay sessions, repo data/).
# BUDGET_STREAMS_PER_IP_HOUR=6
# BUDGET_STREAMS_PER_DAY=150
# BUDGET_MAX_CONCURRENT=4
# BUDGET_MAX_REPLAYS=200
# ECHO_DATA_DIR=data

# Set by the platform or by pytest. Do not set them in .env.
# AZURE_CLIENT_ID and CONTAINER_APP_NAME come from the Container Apps deploy.
# ECHO_NO_DOTENV=1 and ECHO_FOUNDRY_IT=1 are for the test runner.
